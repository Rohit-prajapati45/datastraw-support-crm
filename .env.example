# Backend environment variables. Copy this file to backend/.env for local development.
# Railway supplies PORT automatically; do not set it there unless needed.
PORT=5000

# Comma-separated frontend origins allowed to call the API.
# Set this to your Render Static Site URL on Railway.
CORS_ORIGIN=http://localhost:5173

# Optional SQLite file path. Leave blank locally. On Railway, use a mounted volume path,
# for example /data/support-crm.db, to preserve data across deploys.
SQLITE_DB_PATH=

# Optional: enables Gemini AI summaries. The CRM works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
